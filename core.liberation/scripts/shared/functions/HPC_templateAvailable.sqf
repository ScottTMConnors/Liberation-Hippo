// Is a faction template playable in this role with the loaded mods? Inspects template data
// without executing it or changing the selected factions.
// Bundled templates are looked up in HPC_templateIndex (mod_template\template_index.sqf,
// generated by tools/template_audit.py): a few of the role's infantry classes that exist only
// with the template's mod. Its primary class must exist, and most of the listed ones.
// Templates added by the LRX_Template mod are not indexed: their file is scanned once.
params ["_name", ["_role", "east"]];
if (_name in ["", "---"]) exitWith {false};
if (isNil "HPC_templateAvailability") then {HPC_templateAvailability = createHashMap};
private _key = toLower (_name + ":" + _role);
private _cached = HPC_templateAvailability get _key;
if (!isNil "_cached") exitWith {_cached};
if !([_name] call GRLIB_Template_Modloaded) exitWith {HPC_templateAvailability set [_key, false]; false};

private _indexed = (missionNamespace getVariable ["HPC_templateIndex", createHashMap]) get toLower _name;
private _references = [];
if (!isNil "_indexed") then {
    _references = _indexed select ([0, 1] select (_role == "east"));
} else {
    private _path = format ["mod_template\%1\classnames_%2.sqf", _name, _role];
    if (_name in (missionNamespace getVariable ["LRX_mod_list", []])) then {_path = "LRX_Template\" + _path};
    if (fileExists _path) then {
        private _inInfantry = false;
        {
            private _line = trim _x;
            private _lower = toLower _line;
            if (_role == "west" && {_lower find "infantry_units_west" == 0}) then {_inInfantry = true};
            private _equal = _line find "=";
            private _left = if (_equal >= 0) then {trim (_lower select [0,_equal])} else {""};
            if (_inInfantry || {_role == "east" && {_left in ["opfor_rifleman","opfor_sentry","opfor_squad_leader"]}}) then {
                private _quoted = _line splitString (toString [34]);
                if (count _quoted > 1) then {_references pushBackUnique (_quoted select 1)};
            };
            if (_inInfantry && {_line find "];" >= 0}) then {_inInfantry = false};
        } forEach ((preprocessFileLineNumbers _path) splitString (toString [10,13]));
        // vanilla dogs and divers do not show that a faction's mod is loaded
        _references = (_references - ["Alsatian_Random_F","Fin_random_F"]) select [0, 3];
    };
};

private _available = false;
if (_references isNotEqualTo []) then {
    private _exists = _references select {isClass (configFile >> "CfgVehicles" >> _x)};
    private _primary = _references select 0;
    _available = (_primary in _exists) && {_primary isKindOf "CAManBase"} && {count _exists * 2 > count _references};
};
HPC_templateAvailability set [_key, _available];
_available;
