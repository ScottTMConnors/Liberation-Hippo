for "_i" from 1 to 2 do {_unit addItemToVest "CUP_HandGrenade_M67";};
_unit addItemToVest "cwr3_20rnd_9x18_aps_m";
_unit addHeadgear "cwr3_b_headgear_m1_woodland_army_early";

comment "Add items";
_unit linkItem "ItemMap";
