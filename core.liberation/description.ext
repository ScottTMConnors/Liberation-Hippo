class CfgDebriefing {
    class HPC_LoadFailed {
        title = "Hippos Conquest startup stopped";
        description = "Mission initialization did not finish. Check the RPT log for the last loading stage. Your save has not been changed.";
        pictureBackground = "";
    };
    class HPC_FactionUnavailable {
        title = "Required faction unavailable";
        description = "Hippos Conquest stopped because a saved faction requires mods that are not loaded. Enable the required mods and restart. Your save has not been changed.";
        pictureBackground = "";
    };
	class LRXEND1
	{
		title =	"Parameter Error";
		subtitle = "";
		description = "One of the parameters in or the entirety of _Mission_Params is incorrect, please check the parameters to make sure they are in the correct format. Check the report file for more information";
		pictureBackground = "";
	};
};

