// Stop the autonomous manager in this disposable mission so the fixture can
// provide its own observer without racing the real-player proximity check.
GRLIB_endgame = 1;
sleep 12;
private _home = markerPos (sectors_bigtown select 0);
private _oldDensity = GRLIB_civilian_activity;
GRLIB_civilian_activity = 2;
private _grp = createGroup [GRLIB_side_friendly,true];
private _observer = _grp createUnit [blufor_squad_inf select 0,_home,[],0,"NONE"];
for "_i" from 1 to 3 do {[[[_home,24]],[_observer]] call HPC_fnc_civilianTick; sleep 1};
private _civs = +HPC_ambientCivilians;
private _starts = _civs apply {getPosATL _x};
for "_i" from 1 to 9 do {[[[_home,24]],[_observer]] call HPC_fnc_civilianTick; sleep 5};
private _distances = [];
{_distances pushBack (if (isNull _x) then {0} else {_x distance2D (_starts select _forEachIndex)})} forEach _civs;
diag_log ["HPC_MOVEMENT_DISTANCES",_distances];
["civilians.displacement",count _distances > 0 && {_distances findIf {_x > 3} >= 0}] call _assert;
[[],[]] call HPC_fnc_civilianTick;
deleteVehicle _observer;
deleteGroup _grp;
GRLIB_civilian_activity = _oldDensity;
GRLIB_endgame = 0;
private _sector = sectors_military select 0;
private _props = [_sector] call HPC_fnc_sectorFortifications;
private _commander = missionNamespace getVariable ["HPC_sectorCommander_"+_sector,objNull];
private _houses = nearestObjects [getPosATL _commander,["House","Building"],20];
private _interior = _houses findIf {private _house = _x; (_house buildingPos -1) findIf {_x distance (getPosATL _commander) < 1.5} >= 0} >= 0;
["outpost.commanderInterior",!isNull _commander && {_interior} && {_commander distance2D (markerPos _sector) <= 350} && {count units group _commander == 1}] call _assert;
private _tracked = missionNamespace getVariable [format ["LRX_sector_%1_units",_sector],[]];
private _vehicles = missionNamespace getVariable [format ["LRX_sector_%1_vehicles",_sector],[]];
private _towers = _props select {typeOf _x == opfor_patrol || {typeOf _x == "Land_Cargo_Patrol_V1_F"}};
private _towerOccupied = _towers findIf {private _tower = _x; _tracked findIf {alive _x && {_x distance2D _tower < 5} && {(getPosATL _x select 2) > 2}} >= 0} >= 0;
private _gunOccupied = _vehicles findIf {alive _x && {!isNull gunner _x} && {alive gunner _x}} >= 0;
diag_log ["HPC_OUTPOST_OCCUPANCY",count _props,count _towers,count _tracked,count _vehicles,_towerOccupied,_gunOccupied];
["outpost.defenders",_towerOccupied && _gunOccupied] call _assert;
{deleteVehicle _x} forEach _tracked;
{deleteVehicleCrew _x; deleteVehicle _x} forEach _vehicles;
{deleteVehicle _x} forEach _props;
deleteMarker ("HPC_command_"+_sector);
