private _deadline = diag_tickTime+100;
waitUntil {sleep 0.2; count (missionNamespace getVariable ["HPC_headlessClients",[]]) == 2 || diag_tickTime > _deadline};
private _recipient = missionNamespace getVariable ["HC1",objNull];
private _uid = getPlayerUID _recipient;
diag_log ["HPC_REWARD_RECIPIENT",isPlayer _recipient,_uid];
_recipient setVariable ["GRLIB_score_set",1];
_recipient setVariable ["trx_complete",2];
private _group = createGroup [GRLIB_side_friendly,true];
private _shooter = _group createUnit ["B_Soldier_F",markerPos "base_chimera",[],0,"NONE"];
_shooter setVariable ["PAR_Grp_ID","AI_"+_uid,true];
private _resolved = [_shooter] call HPC_fnc_rewardPlayer;
["reward.squad",!isNull _recipient && {_resolved == _recipient}] call _assert;
private _target = createVehicle ["O_MRAP_02_hmg_F",(markerPos "base_chimera") vectorAdd [100,100,0],[],0,"NONE"];
[_target,_shooter,0.4,_shooter] call HPC_fnc_vehicleHit;
private _history = [_target,_target,objNull] call HPC_fnc_killAttribution;
private _enemyGroup = createGroup [GRLIB_side_enemy,true];
private _enemy = _enemyGroup createUnit ["O_Soldier_F",getPosATL _target,[],0,"NONE"];
private _direct = [_target,_enemy,_enemy] call HPC_fnc_killAttribution;
_target setVariable ["HPC_lastVehicleHit",[_shooter,serverTime-601,_uid]];
private _expired = [_target,_target,objNull] call HPC_fnc_killAttribution;
["reward.vehicleHistory",(_history select 0) == _shooter && {(_history select 1) == _recipient} && {_history select 2} && {(_direct select 0) == _enemy} && {isNull (_expired select 0)}] call _assert;
[_target,_shooter,0.4,_shooter] call HPC_fnc_vehicleHit;
private _hostile = +all_hostile_classnames;
all_hostile_classnames pushBackUnique typeOf _target;
_target setVariable ["GRLIB_vehicle_reward",true];
private _ammo = _recipient getVariable ["GREUH_ammo_count",0];
private _fuel = _recipient getVariable ["GREUH_fuel_count",0];
private _score = _recipient getVariable ["GREUH_score_count",0];
private _kills = _recipient getVariable ["GREUH_kills_soft",0];
private _vehiclesKilled = stats_opfor_vehicles_killed_by_players;
// A delayed engine death supplies no shooter; history must still pay the owner.
_target addMPEventHandler ["MPKilled",{_this spawn kill_manager}];
_target setDamage 1;
_deadline = diag_tickTime+8;
waitUntil {sleep 0.1; (_recipient getVariable ["GREUH_ammo_count",0]) > _ammo || diag_tickTime > _deadline};
private _paid = _recipient getVariable ["GREUH_ammo_count",0];
[_target,objNull,objNull] call kill_manager;
["reward.vehicleBounty",_paid > _ammo && {(_recipient getVariable ["GREUH_fuel_count",0])-_fuel == floor ((_paid-_ammo)/2)} && {(_recipient getVariable ["GREUH_score_count",0]) > _score} && {(_recipient getVariable ["GREUH_kills_soft",0]) == _kills+1} && {stats_opfor_vehicles_killed_by_players == _vehiclesKilled+1} && {(_recipient getVariable ["GREUH_ammo_count",0]) == _paid}] call _assert;
all_hostile_classnames = _hostile;
deleteVehicle _target;
// Real projectile on an HC-owned tank tests MPHit locality, not just helper calls.
private _tank = createVehicle ["O_MBT_02_cannon_F",(markerPos "base_chimera") vectorAdd [200,150,0],[],0,"NONE"];
private _crew = GRLIB_side_enemy createVehicleCrew _tank;
_crew setGroupOwner (owner _recipient);
sleep 2;
{_x disableAI "ALL"} forEach units _crew;
private _impact = (getPosASL _tank) vectorAdd [0,0,1.2];
private _rocket = createVehicle ["R_PG32V_F",ASLToAGL (_impact vectorAdd [0,-12,0]),[],0,"CAN_COLLIDE"];
_rocket setShotParents [_shooter,_shooter];
_rocket setVelocity [0,150,0];
_deadline = diag_tickTime+6;
waitUntil {sleep 0.1; count (_tank getVariable ["HPC_lastVehicleHit",[]]) > 0 || diag_tickTime > _deadline};
["reward.projectile",((_tank getVariable ["HPC_lastVehicleHit",[objNull]]) select 0) == _shooter] call _assert;
diag_log ["HPC_REWARD_PROJECTILE",owner _tank,owner _recipient,damage _tank,_tank getVariable ["HPC_lastVehicleHit",[]]];
{deleteVehicle _x} forEach crew _tank;
deleteVehicle _tank; deleteGroup _crew;
deleteVehicle _shooter;deleteGroup _group;
deleteVehicle _enemy;deleteGroup _enemyGroup;
["HC_DROP_ALL|"] call _emit;
["RUN_DONE|6"] call _emit;
